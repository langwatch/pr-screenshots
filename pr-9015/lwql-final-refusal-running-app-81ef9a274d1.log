# f. Control: the same FINAL statement sent straight to ClickHouse as admin, bypassing LWQL. This is the error the refusal stops:
$ /tmp/lw9015/chq.sh "SELECT count() FROM langwatch.projects FINAL" 2>&1 | head -c 600
0

# f (result): on this ClickHouse (25.10.7.6) the FINAL above did NOT fail: it returned 0. More shapes, all sent as admin, each printing its exit code (0 = accepted):
$ /tmp/lw9015/chq.sh "SELECT * FROM langwatch.projects FINAL FORMAT Null" 2>&1 | head -c 300; echo "exit=${PIPESTATUS[0]}"
exit=0

$ /tmp/lw9015/chq.sh "SELECT * FROM langwatch.projects SAMPLE 0.5 FORMAT Null" 2>&1 | head -c 300; echo "exit=${PIPESTATUS[0]}"
exit=0

$ /tmp/lw9015/chq.sh "SELECT * FROM langwatch.projects FINAL FORMAT Null SETTINGS enable_analyzer=0" 2>&1 | head -c 300; echo "exit=${PIPESTATUS[0]}"
exit=0

# Also as the restricted LWQL user (password from the throwaway file):
$ docker exec lw9015-ch clickhouse-client --user langwatch_lwql --password "$(cat /tmp/lw9015/.lwqlch)" -q "SELECT count() FROM langwatch.projects FINAL" 2>&1 | head -c 300; echo "exit=${PIPESTATUS[0]}"
0
exit=0

# Only FINAL on the PostgreSQL engine table itself raises ILLEGAL_FINAL here:
$ /tmp/lw9015/chq.sh "SELECT count() FROM langwatch.projects_pg FINAL" 2>&1 | head -c 300; echo "exit=${PIPESTATUS[0]}"
Received exception from server (version 25.10.7):
Code: 181. DB::Exception: Received from localhost:9000. DB::Exception: Storage PostgreSQL doesn't support FINAL. (ILLEGAL_FINAL)
(query: SELECT count() FROM langwatch.projects_pg FINAL)
exit=181

