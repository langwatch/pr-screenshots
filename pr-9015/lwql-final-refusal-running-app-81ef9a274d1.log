{"columns":[{"name":"count()","type":"UInt64"}],"rows":[{"count()":0}],"statistics":{"elapsedMs":12,"rowsRead":0,"bytesRead":0,"rowsReturned":1},"diagnostics":[{"code":"UNBOUNDED_TIME_RANGE","message":"langwatch.traces was read with no condition on OccurredAt, so the read covers the whole history this project has rather than a window of it. Add a range on OccurredAt to bound the scan.","meta":{"view":"langwatch.traces","timeColumn":"OccurredAt"}}],"followsTimeWindow":false,"followsGranularity":false}
