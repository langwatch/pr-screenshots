projects_pg	93702806-f303-47d7-bedd-f8daf83112ff	lwql-credentials=fea6eecad3ace27f

$ /tmp/lw8875/q.sh "SELECT TenantId, ProjectName FROM projects LIMIT 1"
{"columns":[{"name":"TenantId","type":"String"},{"name":"ProjectName","type":"String"}],"rows":[{"TenantId":"local-dev-project","ProjectName":"Local Dev Project"}],"statistics":{"elapsedMs":64,"rowsRead":4,"bytesRead":341,"rowsReturned":1},"diagnostics":[{"code":"UNBOUNDED_TIME_RANGE","message":"langwatch.projects was read with no condition on CreatedAt, so the read covers the whole history this project has rather than a window of it. Add a range on CreatedAt to bound the scan.","meta":{"view":"langwatch.projects","timeColumn":"CreatedAt"}}],"followsTimeWindow":false,"followsGranularity":false}
HTTP 200

# Rotation step 1 (operator): new reader password in Postgres.
$ /tmp/lw8875/pgq.sh "ALTER ROLE lwql_ro PASSWORD '$(cat /tmp/lw8875/.pw2)'"
ALTER ROLE

# Rotation step 2 (operator): re-render the access config with password 2 (the app's own render task), in place. ClickHouse reloads it; it is not restarted.
$ READER=pw2 /tmp/lw8875/run.sh pnpm --filter @langwatch/tasks task lwql-render-access-config 2>&1 | grep -o "\"task\":\"lwql-render-access-config\",\"msg\":\"task finished\""; ls -i /tmp/lw8875/rendered/config.d/lwql-named-collection.yaml; cat /tmp/lw8875/inode-before
"task":"lwql-render-access-config","msg":"task finished"
11474326 /tmp/lw8875/rendered/config.d/lwql-named-collection.yaml
11474326 rendered/config.d/lwql-named-collection.yaml

